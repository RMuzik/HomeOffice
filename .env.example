# ══════════════════════════════════════════
#  HomeOffice Affiliate Bot — Environment Variables
#  Copier en .env et remplir les valeurs
# ══════════════════════════════════════════

# ─── Pinterest API ────────────────────────
# https://developers.pinterest.com/apps/
PINTEREST_ACCESS_TOKEN=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# ─── Amazon Associates ────────────────────
# https://affiliate-program.amazon.fr/
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_ASSOCIATE_TAG=

# ─── AI APIs ──────────────────────────────
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# https://platform.openai.com/api-keys (pour DALL-E)
OPENAI_API_KEY=

# ─── Analytics ────────────────────────────
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
GA4_API_SECRET=

# ─── Site Config ──────────────────────────
SITE_URL=https://homeofficesetup.pro
SITE_NAME=HomeOffice Pro

# ─── Notifications ────────────────────────
# Créer un webhook dans Settings > Intégrations sur Discord
DISCORD_WEBHOOK_URL=

# ─── Dev ──────────────────────────────────
NODE_ENV=development
# En development sans API keys → mode mock automatique
